{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "packageRules": [
    {
      "description": "Cap TypeScript at ^6 — @typescript-eslint 8.x peer-requires <6.1.0 (flag #20 class)",
      "matchPackageNames": [
        "typescript"
      ],
      "allowedVersions": "^6"
    },
    {
      "description": "Cap chalk at ^4 — v5+ ESM-only breaks CJS build + engines>=18 (dockervis 6c76e9e precedent)",
      "matchPackageNames": [
        "chalk"
      ],
      "allowedVersions": "^4"
    }
  ]
}
