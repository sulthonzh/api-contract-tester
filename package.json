{
  "name": "api-contract-tester",
  "version": "1.0.0",
  "description": "Comprehensive tool for testing API contracts between frontend and backend systems",
  "main": "dist/index.js",
  "bin": {
    "act": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc && tsc --emitDeclarationOnly",
    "dev": "tsc --watch",
    "test": "node --test test/test.mjs",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "api",
    "contract",
    "testing",
    "frontend",
    "backend",
    "validation",
    "typescript",
    "cli"
  ],
  "author": "Sulthonzh",
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "ajv": "^8.12.0",
    "chalk": "^4.1.2",
    "ora": "^9.0.0",
    "inquirer": "^8.2.5",
    "js-yaml": "^4.1.0",
    "axios": "^1.6.0",
    "diff": "^9.0.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.3",
    "@types/js-yaml": "^4.0.6",
    "@types/diff": "^8.0.0",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.0",
    "vitest": "^1.0.0",
    "eslint": "^8.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
