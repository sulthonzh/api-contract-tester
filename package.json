{
  "name": "api-contract-tester",
  "version": "1.0.0",
  "description": "Comprehensive tool for testing API contracts between frontend and backend systems",
  "main": "dist/index.js",
  "bin": {
    "act": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "dev": "tsc --watch",
    "test": "node --test test/test.mjs",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "api",
    "contract",
    "testing",
    "frontend",
    "backend",
    "validation",
    "typescript",
    "cli"
  ],
  "author": "Sulthonzh",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.12.0",
    "axios": "^1.6.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "diff": "^9.0.0",
    "inquirer": "^14.0.0",
    "js-yaml": "^5.0.0",
    "ora": "^9.0.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.3",
    "@types/js-yaml": "^4.0.6",
    "@types/node": "^24.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/sulthonzh/api-contract-tester"
  },
  "homepage": "https://github.com/sulthonzh/api-contract-tester#readme",
  "bugs": {
    "url": "https://github.com/sulthonzh/api-contract-tester/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "types": "dist/index.d.ts"
}
